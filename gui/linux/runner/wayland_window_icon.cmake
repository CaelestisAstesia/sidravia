# Shared by the real GTK runner and its native lifecycle acceptance executable.
set(SIDRAVIA_WAYLAND_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}")
function(sidravia_wayland_window_icon target)
  pkg_check_modules(WAYLAND REQUIRED IMPORTED_TARGET wayland-client)
  find_program(WAYLAND_SCANNER wayland-scanner REQUIRED)
  foreach(protocol xdg-shell xdg-toplevel-icon-v1)
    set(xml "${SIDRAVIA_WAYLAND_SOURCE_DIR}/../protocols/${protocol}.xml")
    set(header "${CMAKE_CURRENT_BINARY_DIR}/${protocol}-client-protocol.h")
    set(code "${CMAKE_CURRENT_BINARY_DIR}/${protocol}-protocol.c")
    add_custom_command(OUTPUT "${header}" COMMAND "${WAYLAND_SCANNER}" client-header "${xml}" "${header}" DEPENDS "${xml}")
    add_custom_command(OUTPUT "${code}" COMMAND "${WAYLAND_SCANNER}" private-code "${xml}" "${code}" DEPENDS "${xml}")
    target_sources(${target} PRIVATE "${header}" "${code}")
  endforeach()
  target_sources(${target} PRIVATE "${SIDRAVIA_WAYLAND_SOURCE_DIR}/wayland_window_icon.cc")
  target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
  target_link_libraries(${target} PRIVATE PkgConfig::WAYLAND)
endfunction()
